# JARVIS Personal Autonomous AI Agent Configuration

APP_ENV=development
JARVIS_NAME=JARVIS

# Google Gemini Brain Configuration
# Get your free developer key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
GEMINI_BACKUP_API_KEY_2=
GEMINI_BACKUP_API_KEY_3=
GEMINI_BACKUP_API_KEY_4=
GEMINI_BACKUP_API_KEY_5=
GEMINI_BACKUP_API_KEY_6=
GEMINI_BACKUP_API_KEY_7=
GEMINI_BACKUP_API_KEY_8=
GEMINI_MODEL=gemini-3.5-flash

# Execution & Safety Boundaries
WORKSPACE_ROOT=
NOTES_DIR=
MAX_AGENT_STEPS=20
MAX_REPAIR_ATTEMPTS=3

# Interaction Modes
VOICE_ENABLED=true
SCREEN_ENABLED=true
MEMORY_ENABLED=true
TELEGRAM_ENABLED=false
PHONE_ENABLED=false

# Server Settings
HOST=127.0.0.1
PORT=8010
VOICE_FINISH_MS=900
